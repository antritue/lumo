{
	"name": "lumo",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky",
		"remotion:studio": "remotion studio remotion/index.ts",
		"remotion:render:en": "remotion render remotion/index.ts Promo public/promo.mp4 --codec h264 --audio-codec aac --overwrite && npx remotion still remotion/index.ts Promo public/promo-thumb.jpg --frame 390 --overwrite",
		"remotion:render:vi": "remotion render remotion/index.ts PromoVi public/promo-vi.mp4 --codec h264 --audio-codec aac --overwrite && npx remotion still remotion/index.ts PromoVi public/promo-vi-thumb.jpg --frame 390 --overwrite",
		"remotion:render": "npm run remotion:render:en && npm run remotion:render:vi"
	},
	"dependencies": {
		"@polar-sh/nextjs": "1.1.1",
		"@polar-sh/sdk": "1.3.2",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-popover": "1.3.1",
		"@radix-ui/react-slot": "1.5.0",
		"@supabase/ssr": "0.12.7",
		"@supabase/supabase-js": "2.119.2",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.78.0",
		"next": "16.4.6",
		"next-intl": "4.15.3",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"resend": "6.39.0",
		"tailwind-merge": "3.7.1",
		"zod": "4.6.7",
		"zustand": "5.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@remotion/cli": "4.0.546",
		"@remotion/google-fonts": "4.0.546",
		"@tailwindcss/postcss": "4",
		"@testing-library/jest-dom": "8.0.0",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.13",
		"@types/node": "26",
		"@types/react": "19",
		"@types/react-dom": "19",
		"fallow": "3.48.0",
		"happy-dom": "21.0.4",
		"husky": "9.1.7",
		"supabase": "3.3.0",
		"tailwindcss": "4",
		"remotion": "4.0.546",
		"typescript": "6",
		"vitest": "5.1.1"
	}
}
