{
	"name": "lumo",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky",
		"remotion:studio": "remotion studio remotion/index.ts",
		"remotion:render": "remotion render remotion/index.ts Promo public/promo.mp4 --codec h264 --audio-codec aac --overwrite && npx remotion still remotion/index.ts Promo public/promo-thumb.jpg --frame 0 --overwrite"
	},
